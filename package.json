{
  "name": "clutchly-cs2",
  "version": "0.3.1",
  "private": true,
  "main": "electron/main.cjs",
  "description": "A premium, fully-functional CS2 match tracking platform (cstracker.gg alternative) — Steam API, .dem parsing, chat archive, teammates, and server location tracking.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/package-site.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "overlay": "electron electron/main.cjs",
    "overlay:dev": "npm run dev",
    "pack:overlay": "electron-builder --dir",
    "dist:overlay": "electron-builder --win nsis",
    "release": "node scripts/release.mjs",
    "worker": "tsx src/worker/index.ts",
    "feed": "tsx src/worker/liveFeedStandalone.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@laihoe/demoparser2": "^0.42.0",
    "@prisma/client": "5.20.0",
    "bullmq": "5.20.0",
    "cheerio": "^1.2.0",
    "demofile": "^2.10.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "11.5.4",
    "ioredis": "5.4.1",
    "next": "14.2.35",
    "node-cs2": "^2.3.1",
    "proxy-agent": "^6.5.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "steam-user": "^5.3.0",
    "unbzip2-stream": "^1.4.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.16.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@types/unbzip2-stream": "^1.4.3",
    "autoprefixer": "10.4.20",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "8.4.45",
    "prisma": "5.20.0",
    "tailwindcss": "3.4.11",
    "tsx": "4.19.1",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
